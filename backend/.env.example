NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://advinhasong:advinhasong@localhost:5432/advinhasong?schema=public
JWT_SECRET=development-only-change-this-secret-at-least-32-chars
ADMIN_API_KEY=development-admin-key-change-me
CATALOG_BATCH_SIZE=9
CATALOG_INTERVAL_MS=60000
CATALOG_REFRESH_HOURS=168
APPLE_REQUEST_DELAY_MS=4000
SCHEDULER_ENABLED=true
# Optional: override bundled ffmpeg binary
# FFMPEG_PATH=C:/tools/ffmpeg.exe
# Optional: reuse an existing persistent development database directory
# LOCAL_POSTGRES_DIR=D:/advinhasong/.local/postgres
# Minimum playable songs imported by npm run catalog:sync
CATALOG_MIN_SONGS=5000

# Supabase credentials: keep actual values only in .env.
# The API keys do not replace the PostgreSQL database password.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=server-only-secret
# SUPABASE_PUBLISHABLE_KEY=publishable-key
# Session pooler port 5432 supports IPv4 and Prisma migrations.
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
