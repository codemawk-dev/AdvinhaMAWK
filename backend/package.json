{
  "name": "advinhasong-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "supabase:transfer": "tsx scripts/supabase-transfer-rest.ts",
    "catalog:sync": "tsx src/catalog/cli.ts",
    "catalog:worker": "tsx src/catalog/worker.ts",
    "postinstall": "prisma generate",
    "test:live": "tsx scripts/smoke-live.ts",
    "test:stack": "tsx scripts/smoke-stack.ts",
    "catalog:audit-audio": "tsx scripts/audit-audio.ts",
    "db:local": "tsx scripts/dev-db.ts",
    "db:local:stop": "tsx scripts/stop-dev-db.ts",
    "supabase:setup": "tsx scripts/supabase-setup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "ffmpeg-static": "^5.3.0",
    "luxon": "^3.7.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.10.0",
    "prisma": "6.19.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
